{
  "name": "@devmatrix/console",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run build:hosted && npm run build:device",
    "build:hosted": "vite build --mode hosted --outDir dist-hosted",
    "build:device": "vite build --mode device --outDir dist-device && node scripts/gen-header.mjs"
  },
  "dependencies": {
    "@noble/ed25519": "3.2.0",
    "@noble/hashes": "2.4.0",
    "fflate": "0.8.3",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.6",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vite-plugin-singlefile": "2.3.3"
  }
}
